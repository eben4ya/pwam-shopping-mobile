# Copy this file to .env and fill in your values
# Never commit .env to version control

# Base URL of the backend API
# Android emulator (reaches host machine localhost):
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# iOS simulator or Expo Go on the same machine:
# EXPO_PUBLIC_API_URL=http://localhost:3000
# Physical device (use your machine's local IP):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000

# Google OAuth — Web client ID (created in Google Cloud Console → Credentials → Web application)
# Used for expo-auth-session on both platforms
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Google OAuth — Android client ID (create an Android OAuth credential in Google Cloud Console)
# Requires your app's package name and SHA-1 fingerprint
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
